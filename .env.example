# ============================================================
#  Configuración de la app "Muro de Saludos"
#  Copia este archivo como .env y rellena los valores.
#     cp .env.example .env
#  NUNCA subas el archivo .env a Git (ya está en .gitignore).
# ============================================================

# --- Región y bucket de S3 ---
AWS_REGION=us-east-1
S3_BUCKET=muro-saludos-aws-chile-2026

# --- Prefijo (carpeta) dentro del bucket donde se guardan las fotos ---
S3_PREFIX=saludos/

# ============================================================
#  CREDENCIALES DE AWS (ver README: hay 2 formas)
#
#  OPCIÓN RECOMENDADA (producción en EC2):
#     NO pongas claves aquí. Usa un IAM Role adjunto a la EC2.
#     Deja AWS_ACCESS_KEY_ID y AWS_SECRET_ACCESS_KEY VACÍOS.
#     boto3 tomará las credenciales del rol automáticamente.
#
#  OPCIÓN RÁPIDA (demo / local):
#     Rellena las dos variables de abajo con tus claves IAM.
#     Úsalo solo si NO puedes adjuntar un rol a la EC2.
# ============================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Modo de servir imágenes ---
#  presigned  -> URLs firmadas temporales (bucket PRIVADO, recomendado)
#  public     -> URLs públicas directas (requiere bucket con lectura pública)
IMAGE_URL_MODE=presigned

# Clave para firmar la sesión de Flask (cámbiala por algo aleatorio)
FLASK_SECRET_KEY=cambia-esto-por-un-valor-aleatorio-largo
